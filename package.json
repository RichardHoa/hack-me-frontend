{
	"name": "frontend-hack-me",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.3",
		"@inlang/paraglide-js": "^2.12.0",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.53.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24.10.13",
		"@vitest/browser": "^3.2.4",
		"drizzle-kit": "^0.30.6",
		"eslint": "^9.39.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^16.5.0",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.0",
		"svelte": "^5.53.2",
		"svelte-check": "^4.4.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^0.3.0",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"axios": "^1.13.5",
		"dompurify": "^3.3.1",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.40.1",
		"google-auth-library": "^10.5.0",
		"jsdom": "^26.1.0",
		"jwt-decode": "^4.0.0",
		"lucide-svelte": "^0.526.0",
		"marked": "^16.4.2",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.8"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		   "overrides": {
      "minimatch": ">=10.2.1",
      "esbuild": ">=0.25.0",
      "cookie": ">=0.7.0"
    }
	}
}
